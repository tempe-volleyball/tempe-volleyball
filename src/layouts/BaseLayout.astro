---
// The public page shell: header (hero + nav), main column with an optional right sidebar of ladder widgets, footer.
import '../styles/global.css'
import { env } from 'cloudflare:workers'
import LadderWidget from '../components/LadderWidget.astro'
import SiteFooter from '../components/SiteFooter.astro'
import SiteHeader from '../components/SiteHeader.astro'
import { CF_BEACON_SRC, analyticsTags, cfBeaconAttr, ga4LoaderScript } from '../lib/analytics/tags'
import { announcementActive } from '../lib/content/settings'
import { isIndexable } from '../lib/indexing'
import { SITE_NAME } from '../lib/site'
import { NEWS_FEED_ROUTE, normalisePath } from '../lib/wp-import/routes'
import type { Site } from '../server/site'

type Props = {
  /** The full <title>, e.g. documentTitle(page.title). */
  title: string
  description: string
  site: Site
  /** Show the ladder widgets on the right (content pages). League pages use the full width. */
  sidebar?: boolean
  /** Path for the canonical URL; defaults to the request path without a trailing slash. */
  canonicalPath?: string
  ogImage?: string
  ogType?: 'website' | 'article'
}
const { title, description, site, sidebar = false, canonicalPath, ogImage, ogType = 'website' } = Astro.props
const canonical = new URL(canonicalPath ?? normalisePath(Astro.url.pathname), Astro.site)
const image = new URL(ogImage ?? '/images/hero-1500.webp', Astro.site)
// Edited in the admin (Site settings); changing it purges every cached page (tag `site`).
const banner = site.settings.announcement
const showBanner = announcementActive(banner, new Date())
// Analytics tags only in production on www.tempevb.com (Settings → Analytics; docs/admin.md §2).
const tracking = analyticsTags(site.settings.analytics, isIndexable(Astro.url, env.SITE_ENV))
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} news`} href={NEWS_FEED_ROUTE} />
    <link rel="preload" href="/fonts/lato-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/noto-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link
      rel="preload"
      as="image"
      href="/images/hero-1500.webp"
      imagesrcset="/images/hero-800.webp 800w, /images/hero-1500.webp 1500w"
      imagesizes="100vw"
      fetchpriority="high"
    />
    <meta name="theme-color" content="#104293" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content="en_AU" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {tracking.searchConsoleVerification && <meta name="google-site-verification" content={tracking.searchConsoleVerification} />}
    {tracking.ga4 && <script is:inline set:html={ga4LoaderScript(tracking.ga4.id, tracking.ga4.loading)} />}
    {tracking.cfBeaconToken && <script is:inline defer src={CF_BEACON_SRC} data-cf-beacon={cfBeaconAttr(tracking.cfBeaconToken)} />}
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#content"
      class="bg-accent text-ink sr-only z-50 px-4 py-2 font-bold focus:not-sr-only focus:absolute focus:top-2 focus:left-2"
    >
      Skip to content
    </a>
    {showBanner && (
      <div
        role="status"
        class={`px-4 py-2 text-center text-sm font-semibold ${banner.tone === 'warning' ? 'bg-accent text-ink' : 'bg-brand text-white'}`}
      >
        {banner.text}
        {banner.linkUrl && (
          <>
            {' '}
            <a href={banner.linkUrl} class="underline underline-offset-2">
              {banner.linkLabel || 'More'}
            </a>
          </>
        )}
      </div>
    )}
    <SiteHeader menu={site.menu} pathname={Astro.url.pathname} social={site.settings.social} />
    <div class="mx-auto w-full max-w-6xl flex-1 px-4 py-10 lg:px-8 lg:py-16">
      {sidebar ? (
        <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_21rem]">
          <main id="content" class="min-w-0">
            <slot />
          </main>
          <aside aria-labelledby="sidebar-ladders" class="space-y-8">
            <h2 id="sidebar-ladders" class="text-3xl">
              Ladders
            </h2>
            {site.current.map((item) => (
              <LadderWidget item={item} />
            ))}
          </aside>
        </div>
      ) : (
        <main id="content" class="min-w-0">
          <slot />
        </main>
      )}
    </div>
    <SiteFooter site={site} />
  </body>
</html>
