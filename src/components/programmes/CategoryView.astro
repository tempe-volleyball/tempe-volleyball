---
import { prepareHtml } from '../../lib/content'
import { PROGRAMME_PATH_PREFIX } from '../../lib/programmes'
import { KIND_INDEX } from '../../server/programmes/route'
import type { CategoryPage } from '../../server/programmes/public'
import Breadcrumbs from './Breadcrumbs.astro'
import ProgrammeCards from './ProgrammeCards.astro'

// A category landing page (/mixed-leagues …; docs/admin.md §3.2): the intro Michael edits in Admin → Categories,
// then a card per active programme in it. A new programme appears here on its own; a retired one leaves. Under
// the cards, links to /enrol and to the kind index page of each kind listed (/training, /programs, /events).
type Props = { data: CategoryPage; titles?: Map<string, string> }
const { data, titles } = Astro.props
const { category, cards } = data
const intro = category.intro?.html ?? ''
const kindLinks = [...new Set(cards.map((c) => c.kind))].map((k) => ({
  href: PROGRAMME_PATH_PREFIX[k],
  label: k === 'league' ? 'All leagues' : `All ${KIND_INDEX[k].title.toLowerCase()}`,
}))
---

<Breadcrumbs items={[{ label: category.name }]} />
<h1 class="page-title">{category.name}</h1>
{category.status === 'retired' && (
  <p role="status" class="notice mb-6">
    These programs have finished.{' '}
    <a class="underline" href="/enrol">
      See what's open now.
    </a>
  </p>
)}
{intro && <div class="prose mb-10 max-w-3xl" set:html={prepareHtml(intro, titles ? { titles } : {})} />}
{cards.length > 0 ? (
  <ProgrammeCards cards={cards} showTargets />
) : (
  category.status !== 'retired' && (
    <div class="empty max-w-2xl">
      <p>Nothing is running in {category.name} right now.</p>
      <p>
        <a class="link" href="/enrol">
          See what's open for enrolment
        </a>
      </p>
    </div>
  )
)}
<p class="mt-10 flex flex-wrap gap-x-6 gap-y-2">
  <a class="link" href="/enrol">
    Everything open for enrolment
  </a>
  {kindLinks.map((l) => (
    <a class="link" href={l.href}>
      {l.label}
    </a>
  ))}
</p>
