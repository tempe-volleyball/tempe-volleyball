---
import type { CardTarget, ProgrammeCard } from '../../server/programmes/public'

// Programme cards for category pages, /enrol and the kind index pages (docs/public-site.md, "Cards"): the
// enrolment badge (interest programmes: "Taking sign-ups" while they take EOIs, else none), name, summary line, the
// "Next season starts …" sentence, when and where (only under a hand-written summary; the generated one says them),
// the open sessions, terms or seasons with spots left and a meter, then the actions: Enrol while open (Register
// interest → /interest/<slug> for interest programmes), Details, and Fixtures for a league.
type Props = { cards: ProgrammeCard[]; headingLevel?: 2 | 3; showTargets?: boolean }
const { cards, headingLevel = 2, showTargets = false } = Astro.props
const H = headingLevel === 2 ? 'h2' : 'h3'
const MAX_TARGETS = 6
const level = (t: CardTarget) => (!t.meter ? null : t.meter.left === 0 ? 'none' : t.meter.left / t.meter.cap <= 0.2 ? 'low' : 'ok')
const filled = (t: CardTarget) => (t.meter ? Math.round(((t.meter.cap - t.meter.left) / t.meter.cap) * 100) : 0)
---

<ul class="grid gap-4 md:grid-cols-2">
  {cards.map((c) => (
    <li class="card flex flex-col">
      {/* Interest programmes (docs/interest.md) never say "closed": a badge while they take EOIs, else nothing. */}
      {c.interest ? (
        c.interest.open && (
          <p class="mb-3 flex flex-wrap gap-2">
            <span class="badge badge-open">Taking sign-ups</span>
          </p>
        )
      ) : (
        <p class="mb-3 flex flex-wrap gap-2">
          {c.enrolmentOpen ? <span class="badge badge-open">Enrolling now</span> : <span class="badge badge-closed">Enrolment closed</span>}
        </p>
      )}
      <H class="font-display text-xl leading-snug font-bold sm:text-2xl">
        <a class="text-ink hover:text-link hover:underline" href={c.path}>
          {c.name}
        </a>
      </H>
      <p class="text-muted mt-1.5">{c.summary}</p>
      {/* The same "Next season starts …" sentence as the programme page (hand-written text shows as typed). */}
      {c.nextStarts && <p class="mt-3 font-semibold">{c.nextStarts}</p>}
      {c.summaryCustom && (c.schedule || c.venue) && (
        <dl class="mt-3 grid grid-cols-[auto_1fr] gap-x-3 gap-y-1 text-sm">
          {c.schedule && (
            <>
              <dt class="text-muted font-semibold">When</dt>
              <dd>{c.schedule}</dd>
            </>
          )}
          {c.venue && (
            <>
              <dt class="text-muted font-semibold">Where</dt>
              <dd>{c.venue}</dd>
            </>
          )}
        </dl>
      )}
      {showTargets && c.targets.length > 0 && (
        <ul class="border-line mt-4 space-y-3 border-t pt-4 text-sm" aria-label={`Open for enrolment in ${c.name}`}>
          {c.targets.slice(0, MAX_TARGETS).map((t) => (
            <li>
              <div class="flex flex-wrap items-baseline justify-between gap-x-3">
                <span class="font-semibold">{t.label}</span>
                {t.state === 'full' ? (
                  <span class="badge badge-full">Full</span>
                ) : t.state === 'waitlist' ? (
                  <span class="badge badge-info">Waitlist only</span>
                ) : (
                  t.spots && <span class="text-muted">{t.spots}</span>
                )}
              </div>
              {t.meter && t.state === 'open' && (
                <div class="meter mt-1.5" data-level={level(t)} aria-hidden="true">
                  <span style={`width:${filled(t)}%`} />
                </div>
              )}
            </li>
          ))}
          {c.targets.length > MAX_TARGETS && <li class="text-muted">and {c.targets.length - MAX_TARGETS} more</li>}
        </ul>
      )}
      <p class="mt-auto flex flex-wrap gap-2 pt-5">
        {c.enrolmentOpen && (
          <a class="btn btn-enrol btn-sm" href={`${c.path}#enrol`}>
            Enrol<span class="sr-only"> in {c.name}</span>
          </a>
        )}
        {c.interest?.open && (
          <a class="btn btn-enrol btn-sm" href={c.interest.href}>
            Register interest<span class="sr-only"> in {c.name}</span>
          </a>
        )}
        {c.kind === 'league' && (
          <a class="btn btn-brand btn-sm" href={`${c.path}#fixtures`}>
            Fixtures<span class="sr-only"> for {c.name}</span>
          </a>
        )}
        <a class="btn btn-outline btn-sm" href={c.path}>
          Details<span class="sr-only"> about {c.name}</span>
        </a>
      </p>
    </li>
  ))}
</ul>
