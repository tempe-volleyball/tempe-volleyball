---
import EnrolmentForm from '../enrolment/EnrolmentForm'
import type { EnrolmentFormProps } from '../../server/enrolment/public'

// A programme page's enrol section (#enrol): the enrolment form island in a card while something is open, else
// why not and when next. The island hydrates only when it scrolls into view, so it costs nothing on first load;
// until then its fields are disabled with a "getting ready" line (EnrolmentForm), so nothing typed early is lost.
type Props = { enrolment: EnrolmentFormProps | null; name: string; closedText: string; privacyHref?: string | null }
const { enrolment, name, closedText, privacyHref = null } = Astro.props
const open = !!enrolment && enrolment.targets.length > 0
---

<section id="enrol" aria-labelledby="enrol-heading" class="mt-14 scroll-mt-4">
  <h2 id="enrol-heading" class="section-title">
    {open ? `Enrol in ${name}` : 'Enrol'}
  </h2>
  {open ? (
    <div class="card max-w-2xl">
      <EnrolmentForm client:visible {...enrolment} closedText={closedText} privacyHref={privacyHref} />
      <noscript>
        <p class="notice mt-4">The enrolment form needs JavaScript. Contact us and we'll enrol you in {name} by hand.</p>
      </noscript>
    </div>
  ) : (
    <div class="empty max-w-2xl">
      <p>{closedText}</p>
      <p>
        <a class="link" href="/enrol">
          See what's open for enrolment now
        </a>
      </p>
    </div>
  )}
</section>
