---
// The header (docs/public-site.md, "Header"): the hero photo with the logo on the left and the blue nav block on
// the right, over an amber rule. On phones the nav folds into a "Menu" button in a blue bar above the photo, and
// the menu opens as a panel under the bar. The menu is a <details>, so it works without JavaScript; the small
// script only keeps it open on wide screens (for browsers without ::details-content) and closes dropdowns on an
// outside click or Escape. Dropdowns are <details> too, so they open by tap and without JavaScript.
// The home page passes `home`: a taller hero with the H1, a line on what the club is and the join buttons
// (Settings → Home page). Social links (Settings → Social) are icons beside the menu.
import { HERO_FALLBACK, HERO_SIZE, HERO_SIZES, LOGO_FALLBACK, LOGO_SIZE, LOGO_SIZES, heroSrcset, logoSrcset } from '../lib/brand'
import { isActive, type MenuItem } from '../lib/content/menu'
import { safeHref } from '../lib/content/render'
import type { SocialSettings } from '../lib/content/settings'
import { SITE_NAME } from '../lib/site'

export type HomeHero = {
  heading: string
  intro: string
  links: { label: string; url: string; primary: boolean }[]
}
type Props = { menu: MenuItem[]; pathname: string; social?: SocialSettings; home?: HomeHero | undefined }
const { menu, pathname, social, home } = Astro.props
const socials = [
  { label: `${SITE_NAME} on Instagram`, href: safeHref(social?.instagram), icon: 'instagram' },
  { label: `${SITE_NAME} on Facebook`, href: safeHref(social?.facebook), icon: 'facebook' },
].filter((s) => s.href && /^https:\/\//i.test(s.href))

const itemClass = (active: boolean) =>
  [
    'flex w-full items-center justify-between gap-1.5 px-4 py-3 font-display text-base font-bold lg:rounded-md lg:px-3 lg:py-2 xl:px-3.5',
    active ? 'bg-accent text-ink' : 'text-white hover:bg-brand-dark lg:hover:bg-white/12',
  ].join(' ')
const subClass = 'block px-4 py-2.5 font-display text-base font-bold text-white hover:bg-brand-dark lg:rounded-md lg:px-3 lg:py-2'
---

<header class="site-header border-accent relative border-b-4">
  <div class="bg-brand on-dark relative z-30 lg:absolute lg:inset-x-0 lg:top-0 lg:bg-transparent">
    <div class="mx-auto flex max-w-6xl items-center gap-2 px-4 py-2 sm:px-6 lg:justify-end lg:px-8 lg:pt-5">
      <a href="/" class="font-display mr-auto py-2 text-lg font-bold text-white lg:hidden">
        {SITE_NAME}
      </a>
      {socials.length > 0 && (
        <ul class="order-1 flex gap-1.5 lg:order-2" aria-label="Social media">
          {socials.map((s) => (
            <li>
              <a
                href={s.href}
                rel="noopener"
                class="lg:bg-brand-deep/70 flex h-10 w-10 items-center justify-center rounded-full text-white hover:bg-white/15"
                aria-label={s.label}
              >
                {s.icon === 'instagram' ? (
                  <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="2" y="2" width="20" height="20" rx="5" />
                    <circle cx="12" cy="12" r="4" />
                    <circle cx="17.5" cy="6.5" r="1" fill="currentColor" />
                  </svg>
                ) : (
                  <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M14 8h3V4h-3c-2.8 0-5 2.2-5 5v2H7v4h2v9h4v-9h3l1-4h-4V9c0-.6.4-1 1-1z" />
                  </svg>
                )}
              </a>
            </li>
          ))}
        </ul>
      )}
      <details class="site-menu order-2 lg:order-1 lg:max-w-[calc(100%-11rem)]">
        <summary class="font-display bg-accent text-ink flex min-h-10 cursor-pointer lg:hidden items-center gap-2 rounded-md px-3.5 py-2 text-base font-bold">
          <svg
            aria-hidden="true"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
          >
            <path d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <span>Menu</span>
        </summary>
        <nav
          aria-label="Main"
          class="bg-brand border-accent absolute inset-x-0 top-full max-h-[calc(100dvh-3.5rem)] overflow-y-auto border-t-4 pb-2 shadow-xl lg:static lg:max-h-none lg:overflow-visible lg:rounded-lg lg:border-0 lg:p-1.5 lg:shadow-lg"
        >
          <ul class="flex flex-col lg:flex-row lg:flex-wrap lg:justify-end lg:gap-0.5">
            {menu.map((item) => {
              const active = isActive(item, pathname)
              if (item.children.length === 0)
                return (
                  <li>
                    <a
                      class={itemClass(active)}
                      href={item.href ?? '#'}
                      aria-current={active ? 'page' : undefined}
                      {...(item.external ? { rel: 'noopener' } : {})}
                    >
                      {item.label}
                    </a>
                  </li>
                )
              return (
                <li class="lg:relative">
                  <details class="nav-group">
                    <summary class={`${itemClass(active)} cursor-pointer`}>
                      {item.label}
                      <svg aria-hidden="true" width="12" height="12" viewBox="0 0 12 12" fill="currentColor" class="transition-transform">
                        <path d="M1 3.5h10L6 9z" />
                      </svg>
                    </summary>
                    <ul class="bg-brand-dark lg:bg-brand border-accent border-l-4 py-1 lg:absolute lg:top-full lg:right-0 lg:z-30 lg:mt-2 lg:min-w-64 lg:rounded-lg lg:border-t-4 lg:border-l-0 lg:p-1.5 lg:shadow-xl">
                      {item.href && (
                        <li>
                          <a class={subClass} href={item.href}>
                            {item.label}
                          </a>
                        </li>
                      )}
                      {item.children.map((c) => (
                        <li>
                          <a class={subClass} href={c.href ?? '#'} {...(c.external ? { rel: 'noopener' } : {})}>
                            {c.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </details>
                </li>
              )
            })}
          </ul>
        </nav>
      </details>
    </div>
  </div>

  <div class:list={['bg-brand-deep relative overflow-hidden', home ? 'lg:min-h-[34rem]' : 'h-32 sm:h-44 lg:h-60']}>
    <picture>
      <source type="image/avif" srcset={heroSrcset('avif')} sizes={HERO_SIZES} />
      <img
        src={HERO_FALLBACK}
        srcset={heroSrcset('webp')}
        sizes={HERO_SIZES}
        width={HERO_SIZE.width}
        height={HERO_SIZE.height}
        alt=""
        fetchpriority="high"
        class="absolute inset-0 h-full w-full object-cover object-[center_30%]"
      />
    </picture>
    <div class:list={['absolute inset-0', home ? 'hero-shade-home' : 'hero-shade']}></div>
    <div
      class:list={[
        'on-dark relative mx-auto flex max-w-6xl px-4 sm:px-6 lg:px-8',
        home
          ? 'flex-col gap-6 py-6 sm:py-8 lg:min-h-[34rem] lg:justify-between lg:pt-5 lg:pb-14'
          : 'h-full items-center lg:items-start lg:pt-5',
      ]}
    >
      <a href="/" class="block w-fit shrink-0" aria-label={home ? undefined : `${SITE_NAME} home`}>
        <picture>
          <source type="image/avif" srcset={logoSrcset('avif')} sizes={LOGO_SIZES} />
          <img
            src={LOGO_FALLBACK}
            srcset={logoSrcset('webp')}
            sizes={LOGO_SIZES}
            width={LOGO_SIZE.width}
            height={LOGO_SIZE.height}
            alt={home ? `${SITE_NAME}: the one and only since 2005, with the Sydney Uni Volleyball Club` : ''}
            class="h-auto w-[84px] drop-shadow-lg sm:w-[112px] lg:w-[136px]"
          />
        </picture>
      </a>
      {home && (
        <div class="max-w-xl text-white">
          <h1 class="font-display text-[2rem] leading-[1.08] font-bold tracking-tight text-balance sm:text-5xl lg:text-[3.5rem]">
            {home.heading}
          </h1>
          {home.intro && <p class="mt-4 text-base leading-relaxed text-white/90 sm:text-lg">{home.intro}</p>}
          {home.links.length > 0 && (
            <p class="mt-6 flex flex-wrap gap-3">
              {home.links.map((l) => (
                <a class:list={['btn', l.primary ? 'btn-enrol' : 'btn-light']} href={l.url}>
                  {l.label}
                </a>
              ))}
            </p>
          )}
        </div>
      )}
    </div>
  </div>
</header>

<script is:inline>
  ;(() => {
    const menu = document.querySelector('.site-menu')
    if (!menu) return
    const wide = matchMedia('(min-width: 64rem)')
    const sync = () => (menu.open = wide.matches)
    sync()
    wide.addEventListener('change', sync)
    const groups = () => document.querySelectorAll('.nav-group[open]')
    document.addEventListener('click', (e) => {
      groups().forEach((g) => g.contains(e.target) || (g.open = false))
      if (!wide.matches && menu.open && !menu.contains(e.target)) menu.open = false
    })
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return
      const open = [...groups()]
      if (open.length) {
        open.forEach((g) => (g.open = false))
        open[0].querySelector('summary')?.focus()
      } else if (!wide.matches && menu.open) {
        menu.open = false
        menu.querySelector('summary')?.focus()
      }
    })
    document.querySelectorAll('.nav-group').forEach((g) =>
      g.addEventListener('toggle', () => {
        if (g.open) groups().forEach((o) => o === g || (o.open = false))
      }),
    )
  })()
</script>
