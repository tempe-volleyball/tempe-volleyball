---
import { CONTACT } from '../lib/site'
import { sydneyDate } from '../lib/time'
import type { Site } from '../server/site'
import LadderWidget from './LadderWidget.astro'

type Props = { site: Site }
const { site } = Astro.props
const year = sydneyDate(new Date()).slice(0, 4)
---

<footer>
  <div class="bg-footer px-4 py-12 text-white">
    <div class="mx-auto grid max-w-6xl gap-10 md:grid-cols-2 lg:grid-cols-3">
      <div class="grid gap-10 md:col-span-2 md:grid-cols-2">
        {site.current.map((item) => (
          <LadderWidget item={item} heading dark />
        ))}
      </div>
      <div class="space-y-10">
        <section>
          <h2 class="mb-4 text-2xl sm:text-3xl">Contact Us</h2>
          <ul class="space-y-2">
            <li class="flex items-center gap-2">
              <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"></path>
              </svg>
              <span>
                {CONTACT.name} on{' '}
                <a class="text-accent hover:underline" href={CONTACT.phoneHref}>
                  {CONTACT.phone}
                </a>
              </span>
            </li>
            <li class="flex items-center gap-2">
              <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                <path d="m22 6-10 7L2 6"></path>
              </svg>
              <a class="text-accent hover:underline" href={`mailto:${CONTACT.email}`}>
                {CONTACT.email}
              </a>
            </li>
            <li class="flex items-center gap-2">
              <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="2" y="2" width="20" height="20" rx="5"></rect>
                <circle cx="12" cy="12" r="4"></circle>
                <circle cx="17.5" cy="6.5" r="1" fill="currentColor"></circle>
              </svg>
              <a class="text-accent hover:underline" href={CONTACT.instagramUrl} rel="noopener">
                <span class="sr-only">Instagram: </span>
                {CONTACT.instagram}
              </a>
            </li>
          </ul>
        </section>
        <section>
          <h2 class="mb-4 text-2xl sm:text-3xl">Where We Play</h2>
          <ul class="space-y-4">
            {site.venues.map((v) => (
              <li>
                <p class="font-bold">{v.name}</p>
                {v.address && <p class="text-neutral-300">{v.address}</p>}
                {v.mapUrl && (
                  <a class="text-accent text-sm hover:underline" href={v.mapUrl} rel="noopener">
                    Map of {v.name}
                  </a>
                )}
              </li>
            ))}
          </ul>
          <p class="mt-4 text-sm">
            <a class="text-accent hover:underline" href="/where-we-play">
              Getting to our venues
            </a>
          </p>
        </section>
      </div>
    </div>
  </div>
  <div class="bg-accent text-ink px-4 py-3 text-sm">
    <p class="mx-auto max-w-6xl">© {year} Tempe Volleyball League</p>
  </div>
</footer>
