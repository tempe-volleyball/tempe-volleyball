---
// The footer (docs/public-site.md, "Footer"): the logo and a line about the club, the Explore links (Settings →
// Footer), contact details and social links (Settings → Contact, Social), Where We Play (Admin → Venues), then
// the amber copyright bar. Ladders: when Settings → Ladders puts the widgets in the footer they run across the
// top; otherwise the footer just links each league's ladder, so they're never shown twice on one page.
import { LOGO_SIZE, logoSrcset } from '../lib/brand'
import { safeHref } from '../lib/content/render'
import { instagramHandle, telHref } from '../lib/content/settings'
import { SITE_NAME } from '../lib/site'
import { sydneyDate } from '../lib/time'
import { leagueLadderRoute } from '../lib/wp-import/routes'
import type { Site } from '../server/site'
import LadderWidget from './LadderWidget.astro'

type Props = { site: Site }
const { site } = Astro.props
const year = sydneyDate(new Date()).slice(0, 4)
const { contact, social, footer, ladders } = site.settings
const links = footer.links.flatMap((l) => {
  const href = safeHref(l.url)
  return href ? [{ label: l.label, href }] : []
})
const instagram = safeHref(social.instagram)
const facebook = safeHref(social.facebook)
const ladderWidgets = ladders.placement === 'footer' && site.current.length > 0
const h2 = 'font-display mb-4 text-lg font-bold text-white'
const icon = 'mt-0.5 shrink-0 text-accent'
---

<footer class="bg-footer on-dark text-white">
  {ladderWidgets && (
    <section aria-labelledby="footer-ladders" class="border-b border-white/10">
      <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
        <h2 id="footer-ladders" class="font-display mb-6 text-2xl font-bold">
          Ladders
        </h2>
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          {site.current.map((item) => (
            <LadderWidget item={item} rows={ladders.rows} dark />
          ))}
        </div>
      </div>
    </section>
  )}
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:grid-cols-2 sm:px-6 lg:grid-cols-[1.25fr_1fr_1fr_1.25fr] lg:px-8">
    <div>
      <a href="/" class="inline-block" aria-label={`${SITE_NAME} home`}>
        <img
          src="/images/logo-160.webp"
          srcset={logoSrcset('webp')}
          sizes="72px"
          width={LOGO_SIZE.width}
          height={LOGO_SIZE.height}
          alt=""
          loading="lazy"
          decoding="async"
          class="h-auto w-[72px]"
        />
      </a>
      {footer.blurb && <p class="mt-4 max-w-xs text-sm leading-relaxed text-white/80">{footer.blurb}</p>}
    </div>

    {links.length > 0 && (
      <nav aria-labelledby="footer-explore">
        <h2 id="footer-explore" class={h2}>
          Explore
        </h2>
        <ul class="grid grid-cols-2 gap-x-4 gap-y-2 text-sm sm:grid-cols-1">
          {links.map((l) => (
            <li>
              <a class="footer-link" href={l.href}>
                {l.label}
              </a>
            </li>
          ))}
        </ul>
        {!ladderWidgets && site.current.length > 0 && (
          <p class="mt-4 text-sm text-white/80">
            Ladders:{' '}
            {site.current.map((c, i) => (
              <>
                {i > 0 && ', '}
                <a class="footer-link" href={leagueLadderRoute(c.league.slug)}>
                  <abbr title={c.league.name} class="no-underline">
                    {c.league.code}
                  </abbr>
                </a>
              </>
            ))}
          </p>
        )}
      </nav>
    )}

    <section aria-labelledby="footer-contact">
      <h2 id="footer-contact" class={h2}>
        Contact us
      </h2>
      <ul class="space-y-3 text-sm">
        {contact.phone && (
          <li class="flex gap-2.5">
            <svg
              aria-hidden="true"
              class={icon}
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"></path>
            </svg>
            <span>
              {contact.name ? `${contact.name} on ` : ''}
              <a class="footer-link" href={telHref(contact.phone)}>
                {contact.phone}
              </a>
            </span>
          </li>
        )}
        {contact.email && (
          <li class="flex gap-2.5">
            <svg
              aria-hidden="true"
              class={icon}
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <rect x="2" y="4" width="20" height="16" rx="2"></rect>
              <path d="m22 6-10 7L2 6"></path>
            </svg>
            <a class="footer-link break-all" href={`mailto:${contact.email}`}>
              {contact.email}
            </a>
          </li>
        )}
        {instagram && (
          <li class="flex gap-2.5">
            <svg
              aria-hidden="true"
              class={icon}
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <rect x="2" y="2" width="20" height="20" rx="5"></rect>
              <circle cx="12" cy="12" r="4"></circle>
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor"></circle>
            </svg>
            <a class="footer-link" href={instagram} rel="noopener">
              <span class="sr-only">Instagram: </span>
              {instagramHandle(instagram)}
            </a>
          </li>
        )}
        {facebook && (
          <li class="flex gap-2.5">
            <svg aria-hidden="true" class={icon} width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M14 8h3V4h-3c-2.8 0-5 2.2-5 5v2H7v4h2v9h4v-9h3l1-4h-4V9c0-.6.4-1 1-1z" />
            </svg>
            <a class="footer-link" href={facebook} rel="noopener">
              Facebook<span class="sr-only"> ({SITE_NAME})</span>
            </a>
          </li>
        )}
      </ul>
    </section>

    {site.venues.length > 0 && (
      <section aria-labelledby="footer-venues">
        <h2 id="footer-venues" class={h2}>
          Where we play
        </h2>
        <ul class="space-y-4 text-sm">
          {site.venues.map((v) => (
            <li>
              <p class="font-semibold">{v.name}</p>
              {v.address && <p class="text-white/80">{v.address}</p>}
              {v.mapUrl && (
                <a class="footer-link" href={v.mapUrl} rel="noopener">
                  Map<span class="sr-only"> of {v.name}</span>
                </a>
              )}
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
  <div class="bg-accent text-ink px-4 py-3 text-sm sm:px-6 lg:px-8">
    <p class="mx-auto flex max-w-6xl flex-wrap justify-between gap-x-6 gap-y-1">
      <span>© {year} Tempe Volleyball League</span>
      {site.privacyHref && (
        <a class="underline underline-offset-2" href={site.privacyHref}>
          Privacy policy
        </a>
      )}
    </p>
  </div>
</footer>
