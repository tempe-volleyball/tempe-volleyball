---
import NotFound from '../../components/NotFound.astro'
import PageBody from '../../components/PageBody.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { DEFAULT_DESCRIPTION, documentTitle, formatPostDate, metaDescription } from '../../lib/content'
import { breadcrumbLd, newsArticleLd } from '../../lib/seo/jsonld'
import { socialImageUrl } from '../../lib/seo/meta'
import { NEWS_ROUTE, normalisePath, postRoute } from '../../lib/wp-import/routes'
import { cachePublic, tags } from '../../server/cache'
import { publicDb, publicSite, redirectFor } from '../../server/public'
import { findPost, pageTitles } from '../../server/site'

const slug = Astro.params.slug ?? ''
const db = publicDb()
const [site, post, titles] = await Promise.all([publicSite(db), findPost(db, slug), pageTitles(db)])

if (!post) {
  const redirect = await redirectFor(Astro, db, normalisePath(Astro.url.pathname))
  if (redirect) return redirect
  Astro.response.status = 404
} else cachePublic(Astro.cache, tags.news, tags.post(slug))

const origin = (Astro.site ?? Astro.url).origin
const url = new URL(postRoute(slug), origin).href
const description = post ? metaDescription(post.seoDescription ?? post.excerpt, { bodyHtml: post.body.html }) : DEFAULT_DESCRIPTION
const seo = post
  ? {
      imageIds: [post.coverMediaId],
      noindex: post.noindex,
      article: { publishedTime: post.publishedAt, modifiedTime: post.updatedAt, section: post.category },
      jsonLd: [
        newsArticleLd({
          origin,
          url,
          headline: post.title,
          description,
          publishedAt: post.publishedAt,
          updatedAt: post.updatedAt,
          image: socialImageUrl(origin, [post.coverMediaId], site.settings.seo),
          section: post.category,
        }),
        breadcrumbLd([
          { name: 'Home', url: `${origin}/` },
          { name: 'News', url: new URL(NEWS_ROUTE, origin).href },
          { name: post.title, url },
        ]),
      ],
    }
  : undefined
---

{post ? (
  <BaseLayout
    title={documentTitle(post.seoTitle?.trim() || post.title)}
    description={description}
    site={site}
    sidebar
    canonicalPath={postRoute(slug)}
    ogType="article"
    seo={seo}
  >
    <PageBody title={post.title} html={post.body.html} titles={titles}>
      {post.publishedAt && (
        <p slot="meta" class="-mt-4 mb-6 text-sm text-neutral-700">
          <time datetime={post.publishedAt}>{formatPostDate(post.publishedAt)}</time>
        </p>
      )}
      <p class="mt-10">
        <a class="text-link decoration-accent font-semibold underline decoration-2 underline-offset-2" href="/news">
          All news
        </a>
      </p>
    </PageBody>
  </BaseLayout>
) : (
  <BaseLayout title={documentTitle('Page not found')} description={DEFAULT_DESCRIPTION} site={site}>
    <NotFound site={site} />
  </BaseLayout>
)}
