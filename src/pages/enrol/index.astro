---
// /enrol (docs/admin.md §3.3, §3.6): everything open for enrolment now, grouped by category, each card linking to
// its programme's enrol section (where the form is). Generated from the programmes, so a programme appears the
// moment its enrolment opens and leaves when it closes. The intro is hand-editable: publish a page at /enrol in
// Admin → Pages and its body shows above the list (its title becomes the H1). The old year-stamped enrolment pages
// 301 here once the content map archives them (src/lib/wp-import/routes.ts ENROL_REDIRECTS).
import PageBody from '../../components/PageBody.astro'
import ProgrammeCards from '../../components/programmes/ProgrammeCards.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { documentTitle, metaDescription } from '../../lib/content'
import { cachePublic, tags } from '../../server/cache'
import { renderBody } from '../../server/content/blocks'
import { groupByCategory, loadListings } from '../../server/programmes/public'
import { publicDb } from '../../server/public'
import { loadSite, lookupPath } from '../../server/site'

const db = publicDb()
const [site, found, listings] = await Promise.all([loadSite(db), lookupPath(db, '/enrol'), loadListings(db)])

const open = listings.programmes.filter((c) => c.enrolmentOpen)
const groups = groupByCategory(listings, open)
const later = groupByCategory(
  listings,
  listings.programmes.filter((c) => !c.enrolmentOpen),
)
const page = found.page
// The intro page may hold data blocks (a Programme list, say), rendered from live data like any page.
const body = page ? await renderBody(db, site, page.body) : null
cachePublic(Astro.cache, tags.page('/enrol'), tags.programmes, tags.venues, ...(body?.tags ?? []))
const title = page?.title ?? 'Enrol'
const generated =
  open.length > 0
    ? `Enrol in Tempe Volleyball: ${open.map((c) => c.name).join(', ')}. Leagues, training and development programs in Sydney.`
    : 'Enrol in Tempe Volleyball leagues, training and development programs in Sydney.'
---

<BaseLayout
  title={documentTitle(title)}
  description={metaDescription(page?.metaDescription ?? generated, { bodyHtml: page?.body.html ?? '' })}
  site={site}
  canonicalPath="/enrol"
>
  <PageBody title={title} html={body?.html ?? ''} titles={found.titles}>
    {!page && (
      <p class="mb-8 max-w-3xl">
        Pick a league, training session or program below and fill in its form. Full sessions and seasons take a waitlist, and we'll email
        you if a spot comes up.
      </p>
    )}
    {groups.length > 0 ? (
      groups.map((g) => (
        <section aria-labelledby={`enrol-${g.category?.slug ?? 'other'}`} class="mb-12">
          <h2 id={`enrol-${g.category?.slug ?? 'other'}`} class="mb-4 text-2xl font-bold sm:text-3xl">
            {g.category ? (
              <a class="hover:underline" href={`/${g.category.slug}`}>
                {g.category.name}
              </a>
            ) : (
              'More'
            )}
          </h2>
          <ProgrammeCards cards={g.cards} headingLevel={3} showTargets />
        </section>
      ))
    ) : (
      <p class="mb-8 text-lg font-semibold">Nothing is open for enrolment right now. Here's what runs and when it starts next.</p>
    )}
    {later.length > 0 && (
      <section aria-labelledby="enrol-later" class="mt-4">
        <h2 id="enrol-later" class="mb-4 text-2xl font-bold sm:text-3xl">
          {groups.length > 0 ? 'Not open yet' : 'Our programmes'}
        </h2>
        <ul class="space-y-2">
          {later.flatMap((g) =>
            g.cards.map((c) => (
              <li>
                <a class="text-link decoration-accent font-semibold underline decoration-2 underline-offset-2" href={c.path}>
                  {c.name}
                </a>
                {c.nextStarts ? ` – ${c.nextStarts}` : c.schedule ? ` – ${c.schedule}` : ''}
              </li>
            )),
          )}
        </ul>
      </section>
    )}
  </PageBody>
</BaseLayout>
