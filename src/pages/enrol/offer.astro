---
// Where waitlist offer emails link to: /enrol/offer#<token>. The token stays in the fragment (never sent in a URL);
// the island posts it to /api/enrol/offer. Nothing personal is rendered on the server, so the shell can be cached,
// but it's never indexed.
import OfferResponse from '../../components/enrolment/OfferResponse'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { documentTitle } from '../../lib/content'
import { cachePublic, tags } from '../../server/cache'
import { publicDb } from '../../server/public'
import { loadSite } from '../../server/site'

const site = await loadSite(publicDb())
cachePublic(Astro.cache, tags.page('/enrol/offer'))
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow')
---

<BaseLayout title={documentTitle('Your waitlist offer')} description="Accept or decline a spot offered from the waitlist." site={site}>
  <article class="mx-auto max-w-2xl space-y-4 py-6">
    <h1 class="font-display text-brand text-2xl font-bold">Your waitlist offer</h1>
    <OfferResponse client:only="react" />
    <noscript>
      <p>This page needs JavaScript. Reply to your offer email and we'll sort it out.</p>
    </noscript>
  </article>
</BaseLayout>
