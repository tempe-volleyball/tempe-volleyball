---
// Home: the imported home page (pages.path '/', template 'home'), with the ladder widgets alongside.
import PageBody from '../components/PageBody.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { documentTitle, metaDescription } from '../lib/content'
import { SITE_NAME } from '../lib/site'
import { cachePublic, tags } from '../server/cache'
import { renderBody } from '../server/content/blocks'
import { publicDb, publicSite } from '../server/public'
import { lookupPath } from '../server/site'

const db = publicDb()
const [site, found] = await Promise.all([publicSite(db), lookupPath(db, '/')])
const page = found.page
const body = page ? await renderBody(db, site, page.body) : null
cachePublic(Astro.cache, tags.page('/'), ...(body?.tags ?? []))
---

<BaseLayout
  title={page ? documentTitle(`${SITE_NAME} | Social volleyball leagues and training in Sydney`) : SITE_NAME}
  description={metaDescription(page?.metaDescription)}
  site={site}
  sidebar
  canonicalPath="/"
>
  <PageBody title={page?.title ?? `Welcome to ${SITE_NAME}`} html={body?.html ?? ''} titles={found.titles} />
</BaseLayout>
