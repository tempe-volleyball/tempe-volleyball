---
// Home: the imported home page (pages.path '/', template 'home'), with the ladder widgets alongside.
import PageBody from '../components/PageBody.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { documentTitle, metaDescription } from '../lib/content'
import { SITE_NAME } from '../lib/site'
import { cachePublic, tags } from '../server/cache'
import { publicDb } from '../server/public'
import { loadSite, lookupPath } from '../server/site'

const db = publicDb()
const [site, found] = await Promise.all([loadSite(db), lookupPath(db, '/')])
const page = found.page
cachePublic(Astro.cache, tags.page('/'))
---

<BaseLayout
  title={page ? documentTitle(`${SITE_NAME} | Social volleyball leagues and training in Sydney`) : SITE_NAME}
  description={metaDescription(page?.metaDescription)}
  site={site}
  sidebar
  canonicalPath="/"
>
  <PageBody title={page?.title ?? `Welcome to ${SITE_NAME}`} html={page?.body.html ?? ''} titles={found.titles} />
</BaseLayout>
