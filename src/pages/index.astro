---
// Home (docs/public-site.md, "Home page"): the hero says what Tempe Volleyball is (Settings → Home page; the H1
// falls back to the home page's title; buttons only if set there), then the home page's own body (pages.path '/',
// template 'home') under its title as an H2, after the "Leagues this season" cards if they're switched on. The sidebar has the calendar of game nights and, when Settings →
// Ladders puts them there, the ladder widgets.
import HomeCalendar from '../components/HomeCalendar.astro'
import PageBody from '../components/PageBody.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { documentTitle, metaDescription } from '../lib/content'
import { safeHref } from '../lib/content/render'
import { FIXTURE_LIST_ROUTE } from '../lib/fixture-lists'
import { scheduleText, venueSuburb } from '../lib/programme-text'
import { SITE_NAME } from '../lib/site'
import { sydneyDate } from '../lib/time'
import { leagueFixturesRoute, leagueLadderRoute, leagueRoute } from '../lib/wp-import/routes'
import { cachePublic, tags } from '../server/cache'
import { calendarNights } from '../server/competition/month-calendar'
import { renderBody } from '../server/content/blocks'
import { getTurnstileKeys } from '../server/services'
import { publicDb, publicSite } from '../server/public'
import { lookupPath } from '../server/site'

const db = publicDb()
const [site, found, nights] = await Promise.all([publicSite(db), lookupPath(db, '/'), calendarNights(db)])
const today = sydneyDate(new Date())
const page = found.page
const body = page ? await renderBody(db, site, page.body, new Date(), { turnstileSiteKey: getTurnstileKeys()?.siteKey ?? null }) : null
cachePublic(Astro.cache, tags.page('/'), ...(body?.tags ?? []))

const hero = site.settings.home
const links = [
  { ...hero.primary, primary: true },
  { ...hero.secondary, primary: false },
].flatMap((l) => {
  const url = l.label ? safeHref(l.url) : null
  return url ? [{ label: l.label, url, primary: l.primary }] : []
})
const heading = hero.heading || page?.title || `Welcome to ${SITE_NAME}`
// The page's own title is the H2 above its body, unless it would just repeat the hero's H1.
const bodyTitle = page && page.title !== heading ? page.title : ''
// "Leagues this season" cards: off by default (Settings → Home page).
const leagues = hero.showLeagues ? site.current : []
const venueOf = (id: string | null) => site.venues.find((v) => v.id === id)
---

<BaseLayout
  title={page?.seoTitle?.trim() ? documentTitle(page.seoTitle) : `${SITE_NAME} | Social volleyball leagues and training in Sydney`}
  description={metaDescription(page?.metaDescription)}
  site={site}
  sidebar
  canonicalPath="/"
  seo={{ imageIds: [page?.ogImageId], noindex: page?.noindex ?? false }}
  home={{ heading, intro: hero.intro, links }}
>
  <HomeCalendar slot="calendar" nights={nights} today={today} />
  {leagues.length > 0 && (
    <section aria-labelledby="home-leagues" class="mb-12">
      <div class="mb-4 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
        <h2 id="home-leagues" class="section-title mb-0">
          Leagues this season
        </h2>
        <a class="link text-sm" href={FIXTURE_LIST_ROUTE}>
          This week's games in every league
        </a>
      </div>
      <ul class="grid gap-3 sm:grid-cols-2">
        {leagues.map(({ league, summary }) => {
          const venue = venueOf(league.defaultVenueId)
          const where = venue ? venueSuburb(venue.address) || venue.name : ''
          return (
            <li class="card flex flex-col gap-1 p-4">
              <a class="font-display text-ink text-lg leading-snug font-bold hover:underline" href={leagueRoute(league.slug)}>
                {league.name}
              </a>
              <p class="text-muted text-sm">
                {[scheduleText(league), where].filter(Boolean).join(', ')}
                <span class="sr-only">. {summary.name}</span>
              </p>
              <p class="mt-2 flex flex-wrap gap-2">
                <a class="btn btn-brand btn-sm" href={leagueFixturesRoute(league.slug)}>
                  Fixtures<span class="sr-only"> for {league.name}</span>
                </a>
                <a class="btn btn-outline btn-sm" href={leagueLadderRoute(league.slug)}>
                  Ladder<span class="sr-only"> for {league.name}</span>
                </a>
              </p>
            </li>
          )
        })}
      </ul>
    </section>
  )}
  <PageBody title={bodyTitle} html={body?.html ?? ''} titles={found.titles} titleTag="h2" />
</BaseLayout>
