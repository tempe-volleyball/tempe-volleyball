---
// Site search (docs/public-site.md "404 and search"): /search?q=… lists published pages, programmes, categories and
// news posts containing every word. Kept out of search engines (noindex), like any results page. The middleware
// 301s other query strings to the canonical ?q= (src/lib/canonical-query.ts), so each search has one cached URL.
import SearchForm from '../components/SearchForm.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { documentTitle, formatPostDate } from '../lib/content'
import { normaliseQuery } from '../lib/seo/search'
import { cachePublic, tags } from '../server/cache'
import { publicDb, publicSite } from '../server/public'
import { searchSite } from '../server/search'

const q = normaliseQuery(Astro.url.searchParams.get('q'))
const db = publicDb()
const [site, result] = await Promise.all([publicSite(db), q ? searchSite(db, q) : Promise.resolve(null)])
cachePublic(Astro.cache, tags.news, tags.programmes)
const KIND = { page: '', programme: 'Programme', category: 'Category', post: 'News', team: 'Team' } as const
---

<BaseLayout
  title={documentTitle(q ? `Search: ${q}` : 'Search')}
  description="Search the Tempe Volleyball site: leagues, training, programs, news and information pages."
  site={site}
  seo={{ noindex: true }}
>
  <h1 class="page-title">Search</h1>
  <SearchForm value={q} label="Search for" />
  {result && (
    <section aria-labelledby="search-results">
      <h2 id="search-results" class="mb-4 text-2xl font-bold">
        {result.hits.length === 0
          ? `Nothing found for “${q}”`
          : `${result.hits.length} ${result.hits.length === 1 ? 'result' : 'results'} for “${q}”`}
      </h2>
      {result.terms.length === 0 && <p>Type at least one word of two letters or more.</p>}
      {result.hits.length === 0 && result.terms.length > 0 && (
        <>
          <p>Try fewer or different words, or start from one of these:</p>
          <ul class="mt-2 list-disc pl-6">
            <li>
              <a class="text-link decoration-accent underline decoration-2 underline-offset-2" href="/leagues">
                League ladders and fixtures
              </a>
            </li>
            <li>
              <a class="text-link decoration-accent underline decoration-2 underline-offset-2" href="/enrol">
                Enrol
              </a>
            </li>
          </ul>
        </>
      )}
      <ol class="space-y-5">
        {result.hits.map((h) => (
          <li>
            <a class="text-link decoration-accent text-lg font-bold underline decoration-2 underline-offset-2" href={h.path}>
              {h.title}
            </a>
            {(KIND[h.kind] || h.date) && (
              <p class="text-sm text-neutral-700">{[KIND[h.kind], h.date ? formatPostDate(h.date) : ''].filter(Boolean).join(' · ')}</p>
            )}
            {h.text && <p class="mt-1">{h.text}</p>}
          </li>
        ))}
      </ol>
    </section>
  )}
</BaseLayout>
