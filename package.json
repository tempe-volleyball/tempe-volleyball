{
  "name": "tempe-volleyball",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "typecheck": "wrangler types && astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:staging": "wrangler d1 migrations apply DB --env staging --remote",
    "db:migrate:production": "wrangler d1 migrations apply DB --env production --remote",
    "admin:bootstrap": "node scripts/admin-bootstrap.ts",
    "import:wp": "tsx scripts/import-wp.ts",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.0",
    "@astrojs/react": "^7.1.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "astro": "^7.4.0",
    "better-auth": "^1.7.10",
    "drizzle-orm": "^0.45.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "uqr": "^0.1.3",
    "wouter": "^3.13.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}
